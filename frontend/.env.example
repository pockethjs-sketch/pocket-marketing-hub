# Public runtime configuration only. Do not put API keys or shared secrets here.
# The API must authenticate users and authorize project access on the server.
VITE_POCKET_API_URL=

# auto: use the API when a URL exists, otherwise surface a configuration error.
# live: require the API URL and surface configuration errors.
VITE_POCKET_API_MODE=auto

# Request timeout in milliseconds (allowed range: 3,000-60,000).
VITE_POCKET_API_TIMEOUT_MS=60000

# Fetch credential policy: omit, same-origin, or include.
# Keep `omit` unless the selected backend uses a secure cookie session and CORS allows credentials.
VITE_POCKET_API_CREDENTIALS=omit

# false: hide the login form and request a server-issued CLIENT_VIEWER preview session.
# The Apps Script backend must separately enable PUBLIC_PREVIEW_ENABLED.
VITE_POCKET_LOGIN_ENABLED=true

# Storage cutover flag. `supabase` uses Supabase Auth/RLS and stores task reads
# and writes in Postgres while the remaining verified Sheets screens stay on
# their current API during the staged migration.
VITE_POCKET_DATA_BACKEND=sheets

# Public browser configuration. The publishable key is intentionally public;
# authorization must be enforced by Supabase Auth + RLS. Never put a secret or
# service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
