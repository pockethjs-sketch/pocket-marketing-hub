# Public runtime configuration only. Do not put API keys or shared secrets here.
# The API must authenticate users and authorize project access on the server.
VITE_POCKET_API_URL=

# auto: use the API when a URL exists, otherwise use the non-persistent demo.
# live: require the API URL and surface configuration errors.
# demo: never call the API.
VITE_POCKET_API_MODE=auto

# Request timeout in milliseconds (allowed range: 3,000-60,000).
VITE_POCKET_API_TIMEOUT_MS=15000

# Fetch credential policy: omit, same-origin, or include.
# Keep `omit` unless the selected backend uses a secure cookie session and CORS allows credentials.
VITE_POCKET_API_CREDENTIALS=omit
